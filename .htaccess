DirectoryIndex index.php index.html
Options -Indexes

RewriteEngine On
RewriteBase /

# HTTPS and main domain without "www": uncomment once the SSL certificate is active
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://successmedia-tv.com%{REQUEST_URI} [L,R=301]

# /index.html and /index.php → / (a single URL for the home page)
RewriteCond %{THE_REQUEST} \s/index\.(html|php)[\s?] [NC]
RewriteRule ^ / [L,R=301]

# Serve sitemap.xml via sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Route all /api/* requests to api/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Pages of the site (/article/…, /rubrique/…, /lives…) → index.php (SEO tags + application)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Security: deny access to sensitive files
<FilesMatch "\.(db|sqlite|sql|md|log)$">
  Require all denied
</FilesMatch>

# Compression (faster pages, better Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

# Browser cache for static files
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>
